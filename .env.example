# Make a private copy as .env. The first admin is created in the browser.
PORT=4444
MAFIA_IMAGE=mafia-mvp:local
# Optional non-interactive admin provisioning (omit to use the first-run setup).
# MAFIA_ADMIN_USERNAME=change_me
# MAFIA_ADMIN_PASSWORD=replace_with_a_private_password
# MAFIA_PUBLIC_URL=http://localhost:4444

# Optional phase timings in milliseconds.
MAFIA_LOBBY_MS=60000
MAFIA_NIGHT_MS=90000
MAFIA_DISCUSSION_MS=180000
MAFIA_SPEECH_MS=30000
MAFIA_VOTE_MS=60000
MAFIA_REVOTE_MS=30000
MAFIA_PRESENCE_TIMEOUT_MS=5000
MAFIA_BONUSES_ENABLED=false
MAFIA_BONUS_INTERVAL_SECONDS=604800
